# Server
PORT=4000
NODE_ENV=development
APP_BASE_URL=https://api.linkshield.app

# Comma-separated list of allowed frontend/app origins for CORS. Required in
# production - the server refuses to start in production without it rather
# than silently falling back to an open CORS policy.
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Database
DATABASE_URL=postgres://linkshield:linkshield@localhost:5432/linkshield
PGSSL=false

# Auth
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# One-time secret to promote your own logged-in account to admin via
# POST /api/admin/bootstrap (see the Account tab in the app, or the README).
# Leave blank/unset in normal operation - it only works while unset admins
# exist, and does nothing at all if this var isn't set. Remove it again once
# you've claimed admin access.
ADMIN_BOOTSTRAP_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Threat intelligence providers (leave blank to run in heuristic-only / demo mode)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_API_URL=https://urlhaus-api.abuse.ch/v1

# AI explanation provider (Anthropic Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Feature flags
USE_MOCK_THREAT_DATA=true
